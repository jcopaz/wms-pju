# =============================================================================
# VIA WMS - .env.example
# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o .env real para o GitHub.
# =============================================================================

# --- Banco (Supabase / Postgres) ---
# Connection string do Neon (pooled). sslnegotiation=direct e obrigatorio na
# rede MRS: o firewall derruba o handshake SSL padrao do Postgres na porta 5432.
DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@HOST-pooler/BANCO?sslmode=require&channel_binding=require&sslnegotiation=direct
DB_SCHEMA=public
DB_ECHO=false

# --- Ambiente ---
APP_ENV=desenvolvimento

# --- Colunas do Excel do SAP (ajuste aos nomes reais do seu export) ---
SAP_COL_MATNR=Material
SAP_COL_DESC=Texto breve material
SAP_COL_UM=UMB
SAP_COL_DEP=Deposito
SAP_COL_CENTRO=Centro
SAP_COL_SALDO=Estoque
SAP_COL_GRUPO=Grupo de mercadorias

# --- Regras de negocio ---
WMS_LIMITE_APROVACAO=5000
